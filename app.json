{
  "expo": {
    "name": "Animal Marketplace",
    "slug": "animal-marketplace",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "animalmarketplace",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Animal Marketplace to select animal photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Animal Marketplace to use your location for nearby animal listings."
        }
      ],
      "expo-notifications",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.yourname.animalmarketplace"
    }
  }
}